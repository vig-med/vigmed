# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Site / multi-tenant
NEXT_PUBLIC_ROOT_DOMAIN=vigmed.com.br
# Deve ser o domínio primário da Vercel (o que NÃO redireciona para o outro).
# Se a Vercel redireciona apex→www, use www aqui (e o inverso se for o contrário).
NEXT_PUBLIC_SITE_URL=https://www.vigmed.com.br
NEXT_PUBLIC_ADMIN_URL=https://adm.vigmed.com.br
NEXT_PUBLIC_DOCS_URL=https://docs.vigmed.com.br
NEXT_PUBLIC_BLOG_URL=https://blog.vigmed.com.br
VIGMED_DEV_TENANT=site

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# E-mail (Resend) — comunicados, convites, alertas de validade
RESEND_API_KEY=
EMAIL_FROM=VIGMED <noreply@seudominio.com.br>

# Crons (retenção + alertas de documentos)
CRON_SECRET=
